# Obsidian OS — hardened kernel config fragment (Kconfig, merge_config input)
# Applied on top of the Debian trixie amd64 kernel config by scripts/build-kernel.sh.
# Every option here is asserted by scripts/build-kernel.sh and covered in
# docs/HARDENING.md.

# --- hardened allocator / slab -----------------------------------------
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_PAGE_POISONING=y
CONFIG_PAGE_POISONING_NO_SANITY=y
CONFIG_DEBUG_LIST=y
CONFIG_BUG_ON_DATA_CORRUPTION=y

# --- memory protection ---------------------------------------------------
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_VMAP_STACK=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_FALLBACK=n

# --- lockdown (integrity; confidentiality is a per-profile cmdline switch) --
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y

# --- LSM ordering + hardening misc ---------------------------------------
CONFIG_LSM="landlock,lockdown,yama,apparmor,bpf"
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=n            # enforce at runtime only via MOK policy
CONFIG_MODULE_SIG_ALL=y
# RANDOM_TRUST_MODULES is NOT a Kconfig symbol in 6.12 (verified: absent from
# every Kconfig* in the 6.12.107 tree). Its intent -- trust the build-time
# auto-generated signing cert -- is already what MODULE_SIG=y + the default
# CONFIG_MODULE_SIG_KEY="certs/signing_key.pem" do: the build generates the key,
# signs all modules (MODULE_SIG_ALL), and embeds the matching cert in the image.
CONFIG_MODULE_COMPRESS_ZSTD=y
# BLK_DEV_UBLK is the only in-tree `select IO_URING` (drivers/block/Kconfig).
# A `select` from a =m module forces IO_URING back to =y under olddefconfig, so
# the IO_URING=n below cannot land while ublk is enabled. Disable it too; it is
# an experimental userspace block driver the image does not need.
CONFIG_BLK_DEV_UBLK=n
CONFIG_IO_URING=n
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_X86_X32_DISABLED=y
CONFIG_KEXEC=n
CONFIG_HIBERNATION=n

# --- net hardening --------------------------------------------------------
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536
CONFIG_NETFILTER_NETLINK_QUEUE=y     # needed by libvirt/netfilter userspace queue
CONFIG_TCP_SYNCOOKIES=y
CONFIG_INET_DIAG_MEMINFO=y